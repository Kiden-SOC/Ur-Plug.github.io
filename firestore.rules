rules_version = '2';

// =============================================================================
// FIRESTORE SECURITY RULES — Ur Plug
// =============================================================================
// Role hierarchy:
//   super_admin  →  full access + admin management (admin_settings, promote/demote)
//   admin        →  full access to platform moderation (directory, reviews, etc.)
//   producer     →  own provider profile + own bookings/chats
//   consumer     →  own user profile + own bookings/chats
//
// How admin status works (and why we check the Firestore role field):
// Firebase custom claims (set server-side via Admin SDK / Cloud Function) are
// the gold standard. Until that Cloud Function is deployed, these rules fall
// back to checking the `role` field on the user's Firestore document. This is
// acceptable for a private admin panel where you control who gets accounts, but
// you should deploy the custom-claim Cloud Function before this app handles
// real user data at scale. See SECURITY.md for details.
//
// Bootstrap your first super_admin:
//   1. Create the account via the normal sign-up flow (or Firebase Console).
//   2. In Firestore Console: open users/{uid} and set role = 'super_admin'.
//   3. That user can then promote others to 'admin' from the Admin Mgmt tab.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------
    // HELPER FUNCTIONS
    // -----------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Returns true for both admin and super_admin roles.
    // Prefer custom claim once the Cloud Function is deployed:
    //   request.auth.token.admin == true || request.auth.token.super_admin == true
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.super_admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'])
      );
    }

    // Returns true only for super_admin (not plain admin).
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.super_admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin')
      );
    }

    // -----------------------------------------------------------------------
    // USERS
    // -----------------------------------------------------------------------
    match /users/{uid} {
      // Any admin can read any user. Users can read their own doc.
      allow read: if isOwner(uid) || isAdmin();

      // Only the account owner can create their own profile doc.
      allow create: if isOwner(uid);

      // Owners can update their own profile, but NEVER change their own role
      // or accountStatus — those are admin-only fields. This closes the
      // "self-promote to admin" attack vector.
      //
      // Super admin can update any user's role (to promote/demote).
      // Regular admin can update accountStatus (suspend/reinstate).
      allow update: if isSuperAdmin() ||
        isAdmin() ||
        (isOwner(uid) &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.accountStatus == resource.data.accountStatus);

      allow delete: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // PROVIDERS
    // -----------------------------------------------------------------------
    match /providers/{uid} {
      allow read: if true; // public directory — needed for search/matching

      allow create: if isOwner(uid);

      // Providers can update their own listing fields, but not
      // verificationStatus, accountStatus, rating, or completedJobs
      // (those are admin/server-only fields).
      allow update: if isAdmin() || (
        isOwner(uid) &&
        request.resource.data.verificationStatus == resource.data.verificationStatus &&
        request.resource.data.accountStatus == resource.data.accountStatus &&
        request.resource.data.rating == resource.data.rating &&
        request.resource.data.completedJobs == resource.data.completedJobs
      );

      allow delete: if isAdmin();

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.customerUid == request.auth.uid;
        allow update: if false; // reviews are immutable once posted
        allow delete: if isAdmin();
      }

      // Service listings a provider publishes on their own profile
      match /services/{serviceId} {
        allow read: if true;
        allow write: if isOwner(uid) || isAdmin();
      }
    }

    // -----------------------------------------------------------------------
    // ADMIN-ONLY OPERATIONAL COLLECTIONS
    // -----------------------------------------------------------------------

    match /audit_logs/{entryId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if false; // immutable — not even an admin can edit history
      allow delete: if false;
    }

    match /disputes/{disputeId} {
      allow read: if isAdmin() || (isSignedIn() &&
        (resource.data.raisedByUid == request.auth.uid ||
         resource.data.respondentUid == request.auth.uid));
      allow create: if isSignedIn() && request.resource.data.raisedByUid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /appeals/{appealId} {
      allow read: if isAdmin() || isOwner(resource.data.submittedByUid);
      allow create: if isSignedIn() && request.resource.data.submittedByUid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /broadcasts/{broadcastId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /search_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn(); // written by MatchingService on every search
      allow update, delete: if false;
    }

    // Tracks when an admin last viewed a provider's reviews.
    match /admin_review_reads/{providerId} {
      allow read, write: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // SUPER ADMIN — ADMIN SETTINGS
    // -----------------------------------------------------------------------
    // admin_settings stores platform-wide config managed only by the super admin.
    // Currently: admin_settings/quota { maxAdmins: N }

    match /admin_settings/{docId} {
      allow read: if isAdmin(); // all admins can read quota (used in promoteToAdmin check)
      allow write: if isSuperAdmin(); // only super admin can change quota
    }

    // -----------------------------------------------------------------------
    // BOOKINGS
    // -----------------------------------------------------------------------
    match /bookings/{bookingId} {
      allow read: if isAdmin() ||
        (isSignedIn() && (resource.data.customerUid == request.auth.uid ||
                          resource.data.providerUid == request.auth.uid));
      allow create: if isSignedIn() && request.resource.data.customerUid == request.auth.uid;
      allow update: if isAdmin() ||
        (isSignedIn() && (resource.data.customerUid == request.auth.uid ||
                          resource.data.providerUid == request.auth.uid));
      allow delete: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // CHATS
    // -----------------------------------------------------------------------
    match /chats/{chatId} {
      allow read, update: if isAdmin() ||
        (isSignedIn() && request.auth.uid in resource.data.participants);
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin() ||
          (isSignedIn() && request.auth.uid in
            get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
        allow create: if isSignedIn() &&
          request.auth.uid in
            get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
          request.resource.data.senderUid == request.auth.uid;
        allow update: if false; // messages are immutable once sent
        allow delete: if isAdmin();
      }
    }

    // -----------------------------------------------------------------------
    // NOTIFICATIONS
    // -----------------------------------------------------------------------
    match /notifications/{notificationId} {
      allow read, update: if isOwner(resource.data.recipientUid);
      allow create: if isAdmin() || isSignedIn();
      allow delete: if isOwner(resource.data.recipientUid) || isAdmin();
    }
  }
}
